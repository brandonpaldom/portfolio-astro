---
import Layout from "@layouts/Layout.astro";

import ResumeItem from "@components/ResumeItem.astro";

import resume from "@data/resume.json";
---

<Layout
  title="Currículum · Brandon Palmeros — Full-Stack Developer"
  subtitle="Currículum"
  description="Marketing, diseño y desarrollo: la trayectoria que hoy combino para construir productos digitales completos."
>
  <div class="flex flex-col gap-12">
    <section class="flex flex-col gap-5">
      <h2 class="section-title">Experiencia</h2>
      <div class="flex flex-col gap-5">
        {resume.experience.map((item) => <ResumeItem item={item} />)}
      </div>
    </section>

    <section class="flex flex-col gap-5">
      <h2 class="section-title">Educación</h2>
      <div class="flex flex-col gap-5">
        {resume.education.map((item) => <ResumeItem item={item} />)}
      </div>
    </section>

    <section class="flex flex-col gap-5">
      <h2 class="section-title">Certificaciones</h2>
      <div class="flex flex-col gap-5">
        {resume.certifications.map((item) => <ResumeItem item={item} />)}
      </div>
    </section>
  </div>
</Layout>
