---
import Layout from "@layouts/Layout.astro";
import BlogCard from "@components/BlogCard.astro";
import { getCollection } from "astro:content";

// Get all blog posts, newest first
const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout
  title="Blog | Brandon Palmeros - Consultor Digital"
  subtitle="Blog"
  description="Ideas, aprendizajes y reflexiones sobre tecnología, automatización, marketing digital y cómo resolver problemas reales de negocio."
>
  {
    sortedPosts.length > 0 ? (
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {sortedPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    ) : (
      <div class="flex flex-col gap-2 py-12 text-center">
        <h3 class="text-theme-primary text-xl font-medium tracking-tight">Próximamente...</h3>
        <p class="text-theme-subtle">Estoy trabajando en contenido interesante para compartir contigo.</p>
      </div>
    )
  }
</Layout>
