---
import Layout from "@layouts/Layout.astro";

import { Rocket } from "@lucide/astro";
---

<Layout title="Página no encontrada | Brandon Palmeros" description="La página que buscas no existe o ha sido movida.">
  <div class="flex flex-col items-center py-16 text-center">
    <div
      class="bg-theme-contrast/5 ring-theme-contrast/10 text-theme-muted mb-8 flex h-20 w-20 animate-pulse items-center justify-center rounded-full ring-1"
    >
      <Rocket width={32} height={32} />
    </div>
    <h1 class="font-display text-theme-primary text-3xl font-semibold tracking-tight">
      ¡Ups! Parece que te has perdido.
    </h1>
    <p class="text-theme-muted mt-4 mb-8">La página que buscas no existe o ha sido movida.</p>
    <a href="/" class="btn btn-secondary px-6 py-3"> Volver al inicio </a>
  </div>
</Layout>
