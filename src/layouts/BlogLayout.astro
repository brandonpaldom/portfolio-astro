---
import "@styles/global.css";
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/syne/500.css";
import "@fontsource/syne/600.css";

import { ClientRouter } from "astro:transitions";
import SocialShare from "@components/SocialShare.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import Spotlight from "@components/ui/Spotlight.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author?: string;
  tags?: string[];
  heroImage?: string;
}

const { title, description, pubDate, author = "Brandon Palmeros", tags = [], heroImage } = Astro.props;

const formattedDate = new Intl.DateTimeFormat("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(pubDate);

const baseUrl = Astro.url.origin;
const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, baseUrl).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="shortcut icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} | Blog | Brandon Palmeros</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <ClientRouter />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:author" content={author} />
    {heroImage && <meta property="og:image" content={heroImage} />}
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="kJyOJz23V2iAZRK0zOQtTA" async></script>
  </head>
  <body class="text-theme-muted selection:bg-theme-surface-strong selection:text-theme-primary font-sans antialiased">
    <div class="bg-page fixed inset-0 z-[-1]"></div>
    <div class="grid-bg pointer-events-none fixed inset-0 z-[-1]"></div>

    <div class="pointer-events-none fixed inset-0 z-[-1] overflow-hidden">
      <Spotlight className="-top-40 right-0 md:-top-20 md:right-60" />
    </div>

    <div class="noise-bg pointer-events-none fixed inset-0 z-[-1] opacity-[0.04] mix-blend-overlay"></div>

    <div class="mx-auto flex min-h-screen max-w-2xl flex-col px-6 py-12 md:py-20">
      <Navbar />
      <main class="mt-16 mb-20 flex grow flex-col gap-10">
        <article class="flex flex-col gap-10">
          <header class="flex flex-col gap-6">
            <div class="flex flex-col gap-3">
              <h1
                class="font-display text-theme-primary text-3xl leading-tight font-semibold tracking-tight md:text-4xl"
              >
                {title}
              </h1>
              <p class="text-theme-muted text-lg leading-8">{description}</p>
            </div>
            <div class="text-theme-subtle flex flex-wrap items-center gap-3 text-sm">
              <time datetime={pubDate.toISOString()}>
                {formattedDate}
              </time>
              <span>•</span>
              <span>Por {author}</span>
            </div>
            {
              tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag) => (
                    <span class="bg-theme-surface text-theme-secondary ring-theme-contrast/10 rounded-full px-2.5 py-1 text-xs font-medium ring-1 backdrop-blur-md">
                      {tag}
                    </span>
                  ))}
                </div>
              )
            }
          </header>
          {
            heroImage && (
              <img
                src={heroImage}
                alt={title}
                class="ring-theme-contrast/10 w-full rounded-2xl object-cover object-top ring-1"
              />
            )
          }

          <div class="prose prose-neutral dark:prose-invert content-typeset blog-content max-w-none">
            <slot />
          </div>

          <div class="border-theme-contrast/10 mt-8 border-t pt-8">
            <SocialShare title={title} description={description} url={currentUrl} />
          </div>
        </article>
      </main>
      <Footer />
    </div>

    <script>
      document.addEventListener("astro:page-load", () => {
        const codeBlocks = document.querySelectorAll("pre");

        codeBlocks.forEach((codeBlock) => {
          const wrapper = document.createElement("div");
          wrapper.className = "relative group";

          const copyButton = document.createElement("button");
          copyButton.className =
            "absolute top-3 right-3 p-2 rounded-lg bg-theme-surface-strong/80 text-theme-muted hover:text-theme-primary hover:bg-theme-surface-strong/80 transition-all opacity-0 group-hover:opacity-100 ring-1 ring-theme-contrast/10 backdrop-blur-sm cursor-pointer";
          copyButton.innerHTML = `<span class="sr-only">Copy code</span>`;
          copyButton.appendChild(document.createElementNS("http://www.w3.org/2000/svg", "svg"));

          const tooltip = document.createElement("span");
          tooltip.textContent = "Copiado";
          tooltip.className =
            "absolute -top-8 right-0 px-2 py-1 rounded bg-theme-surface-strong text-theme-primary text-xs font-medium opacity-0 transform translate-y-2 transition-all duration-300 ring-1 ring-theme-contrast/20";
          copyButton.appendChild(tooltip);

          const svg = copyButton.querySelector("svg");
          svg.setAttribute("class", "w-4 h-4 fill-current");
          svg.setAttribute("stroke", "currentColor");
          svg.setAttribute("fill", "currentColor");
          svg.setAttribute("stroke-width", "0");
          svg.setAttribute("viewBox", "0 0 512 512");
          svg.setAttribute("xmlns", "http://www.w3.org/2000/svg");

          const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
          path.setAttribute(
            "d",
            "M384 96L384 0h-112c-26.51 0-48 21.49-48 48v288c0 26.51 21.49 48 48 48H464c26.51 0 48-21.49 48-48V128h-95.1C398.4 128 384 113.6 384 96zM416 0v96h96L416 0zM192 352V128h-144c-26.51 0-48 21.49-48 48v288c0 26.51 21.49 48 48 48H240c26.51 0 48-21.49 48-48V384h-48C213.5 384 192 362.5 192 336V352z",
          );
          svg.appendChild(path);

          copyButton.addEventListener("click", () => {
            const code = codeBlock.querySelector("code")?.textContent || "";
            navigator.clipboard.writeText(code).then(() => {
              copyButton.classList.add("text-emerald-400");

              const tooltip = copyButton.querySelector("span:not(.sr-only)");
              tooltip.classList.remove("opacity-0", "translate-y-2");
              tooltip.classList.add("opacity-100", "translate-y-0");

              setTimeout(() => {
                copyButton.classList.remove("text-emerald-400");
                tooltip.classList.remove("opacity-100", "translate-y-0");
                tooltip.classList.add("opacity-0", "translate-y-2");
              }, 2000);
            });
          });

          codeBlock.parentNode.insertBefore(wrapper, codeBlock);
          wrapper.appendChild(codeBlock);
          wrapper.appendChild(copyButton);
        });
      });
    </script>
  </body>
</html>
