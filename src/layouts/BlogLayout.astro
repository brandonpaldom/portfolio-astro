---
import Layout from "./Layout.astro";
import SocialShare from "@components/SocialShare.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author?: string;
  tags?: string[];
  heroImage?: string;
}

const { title, description, pubDate, author = "Brandon Palmeros", tags = [], heroImage } = Astro.props;

const formattedDate = new Intl.DateTimeFormat("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(pubDate);

const baseUrl = Astro.url.origin;
const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, baseUrl).href;
---

<Layout
  title={title}
  description={description}
  documentTitle={`${title} | Blog | Brandon Palmeros`}
  image={heroImage}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:author" content={author} />
  </Fragment>

  <article class="flex flex-col gap-10">
    <header class="flex flex-col gap-6">
      <div class="flex flex-col gap-3">
        <h1 class="page-title">{title}</h1>
        <p class="text-theme-muted text-lg leading-8">{description}</p>
      </div>
      <div class="text-theme-subtle flex flex-wrap items-center gap-3 text-sm">
        <time datetime={pubDate.toISOString()}>
          {formattedDate}
        </time>
        <span aria-hidden="true">•</span>
        <span>Por {author}</span>
      </div>
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="bg-theme-surface text-theme-secondary ring-theme-contrast/10 rounded-full px-2.5 py-1 text-xs font-medium ring-1 backdrop-blur-md">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>
    {
      heroImage && (
        <img
          src={heroImage}
          alt={title}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="bg-theme-surface ring-theme-contrast/10 aspect-video w-full rounded-2xl object-cover object-top ring-1"
        />
      )
    }

    <div class="content-typeset">
      <slot />
    </div>

    <div class="border-theme-contrast/10 mt-8 border-t pt-8">
      <SocialShare title={title} url={currentUrl} />
    </div>
  </article>
</Layout>

<script>
  document.querySelectorAll("pre").forEach((codeBlock) => {
    const wrapper = document.createElement("div");
    wrapper.className = "relative group";
    codeBlock.before(wrapper);
    wrapper.append(codeBlock);

    wrapper.insertAdjacentHTML(
      "beforeend",
      `<button type="button" aria-label="Copiar código" class="absolute top-3 right-3 cursor-pointer rounded-lg bg-theme-surface-strong/80 p-2 text-theme-muted opacity-0 ring-1 ring-theme-contrast/10 backdrop-blur-sm transition-all hover:bg-theme-surface-strong/80 hover:text-theme-primary focus-visible:opacity-100 focus-visible:ring-2 focus-visible:ring-theme-contrast/40 focus-visible:outline-none group-hover:opacity-100">
        <svg class="h-4 w-4 fill-current" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M384 96L384 0h-112c-26.51 0-48 21.49-48 48v288c0 26.51 21.49 48 48 48H464c26.51 0 48-21.49 48-48V128h-95.1C398.4 128 384 113.6 384 96zM416 0v96h96L416 0zM192 352V128h-144c-26.51 0-48 21.49-48 48v288c0 26.51 21.49 48 48 48H240c26.51 0 48-21.49 48-48V384h-48C213.5 384 192 362.5 192 336V352z"/></svg>
        <span class="absolute -top-8 right-0 rounded bg-theme-surface-strong px-2 py-1 text-xs font-medium text-theme-primary opacity-0 ring-1 ring-theme-contrast/20 transition-all duration-300 translate-y-2">Copiado</span>
      </button>`,
    );

    const button = wrapper.querySelector<HTMLButtonElement>("button")!;
    const tooltip = button.querySelector<HTMLSpanElement>("span")!;

    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(codeBlock.querySelector("code")?.textContent ?? "");
      button.classList.add("text-emerald-400");
      tooltip.classList.remove("opacity-0", "translate-y-2");
      tooltip.classList.add("opacity-100", "translate-y-0");
      setTimeout(() => {
        button.classList.remove("text-emerald-400");
        tooltip.classList.remove("opacity-100", "translate-y-0");
        tooltip.classList.add("opacity-0", "translate-y-2");
      }, 2000);
    });
  });
</script>
