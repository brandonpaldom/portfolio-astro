---
import { Image } from "astro:assets";
import RoleTimeline from "./RoleTimeline.astro";

interface Props {
  item: {
    image: string;
    title: string;
    organization: string;
    roles?: Role[];
    start: string;
    end?: string;
    summary?: string;
  };
}

interface Role {
  title: string;
  modality?: string;
}

const { item } = Astro.props;
---

<article class="group flex flex-col gap-3">
  <div class="flex items-start gap-4">
    {
      item.image ? (
        <Image
          src={item.image}
          alt={item.organization}
          width={48}
          height={48}
          class="resume-logo bg-theme-contrast/5 ring-theme-contrast/10 h-12 w-12 shrink-0 rounded-xl object-contain p-1 ring-1 transition-transform group-hover:scale-105"
        />
      ) : (
        <div class="resume-logo bg-theme-surface ring-theme-contrast/10 text-theme-muted font-display group-hover:text-theme-primary flex h-12 w-12 shrink-0 items-center justify-center rounded-xl text-lg font-medium uppercase ring-1 transition-transform group-hover:scale-105">
          {item.organization.charAt(0)}
        </div>
      )
    }
    <div class="mt-0.5 flex flex-col">
      <h3 class="text-theme-primary font-medium">
        {item.title}
      </h3>
      <div class="text-theme-muted mt-0.5 text-sm">
        <span class="text-theme-secondary font-medium">
          {item.organization}
        </span>
        <span class="mx-1.5 opacity-50" aria-hidden="true">•</span>
        <span class="capitalize">
          {item.start}
          {item.end && `— ${item.end}`}
        </span>
      </div>
    </div>
  </div>
  {item.roles && <RoleTimeline roles={item.roles} />}
  {item.summary && <p class="text-theme-muted ml-16 text-sm leading-relaxed">{item.summary}</p>}
</article>
