---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { coverImage, title } = project.data;
---

<article
  class="group bg-theme-surface/30 border-theme-contrast/10 hover:bg-theme-surface/60 hover:border-theme-contrast/20 focus-within:bg-theme-surface/60 focus-within:border-theme-contrast/40 focus-within:ring-theme-contrast/30 relative flex flex-col overflow-hidden rounded-2xl border transition-[transform,background-color,border-color,box-shadow] duration-200 focus-within:ring-2 hover:-translate-y-0.5"
>
  <a href={`/projects/${project.id}`} class="flex h-full flex-col outline-none">
    <div class="relative aspect-[4/3] overflow-hidden">
      <Image
        src={coverImage}
        alt={title}
        width={800}
        height={600}
        class="h-full w-full object-cover transition-transform duration-300 group-focus-within:scale-[1.02] group-hover:scale-[1.02]"
      />
    </div>
    <div class="flex flex-col p-4">
      <h3 class="text-theme-primary truncate font-medium">
        {title}
      </h3>
    </div>
  </a>
</article>
