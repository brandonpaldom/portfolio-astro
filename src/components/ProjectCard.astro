---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { coverImage, title } = project.data;
---

<article
  class="interactive-card group bg-theme-card border-theme-card-border hover:border-theme-contrast/20 focus-within:border-theme-contrast/40 focus-within:ring-theme-contrast/30 relative flex flex-col overflow-hidden rounded-2xl border shadow-sm shadow-neutral-950/5 transition-[background-color,border-color,box-shadow] duration-200 focus-within:shadow-lg focus-within:ring-2 focus-within:shadow-neutral-950/10 hover:shadow-lg hover:shadow-neutral-950/10 dark:shadow-black/20 dark:focus-within:shadow-black/30 dark:hover:shadow-black/30"
>
  <a href={`/projects/${project.id}`} class="flex h-full flex-col outline-none">
    <div class="relative aspect-[4/3] overflow-hidden">
      <Image
        src={coverImage}
        alt={title}
        width={800}
        height={600}
        class="h-full w-full object-cover transition-transform duration-300 group-focus-within:scale-[1.02] group-hover:scale-[1.02]"
      />
    </div>
    <div class="flex flex-col p-4">
      <h3 class="card-title truncate">
        {title}
      </h3>
    </div>
  </a>
</article>
