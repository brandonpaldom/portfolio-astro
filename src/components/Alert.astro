---
import { Terminal, AlertCircle } from "@lucide/astro";

interface Props {
  title: string;
  description: string;
  variant?: "default" | "error";
}

const { title, description, variant = "default" } = Astro.props;
---

<div
  class:list={[
    "flex items-start gap-4 rounded-xl border p-4 shadow-lg ring-1",
    variant === "default" && "border-theme-contrast/10 bg-theme-surface ring-theme-contrast/5",
    variant === "error" && "text-status-error border-red-500/20 bg-red-500/5 ring-red-500/10",
  ]}
>
  <div class="mt-0.5 opacity-80">
    {variant === "default" ? <Terminal width={18} height={18} /> : <AlertCircle width={18} height={18} />}
  </div>
  <div class="flex flex-col gap-1">
    <p class="text-theme-primary text-sm font-medium">{title}</p>
    <p class="text-theme-muted text-sm leading-relaxed">{description}</p>
  </div>
</div>
