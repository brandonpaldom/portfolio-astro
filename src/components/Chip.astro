---
interface Props {
  icon?: boolean;
  color?: "chip-primary" | "chip-secondary";
  label: string;
  class?: string;
}

const { color = "chip-secondary", icon, label, class: className } = Astro.props;
---

<div
  class:list={[
    "flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ring-1 backdrop-blur-md",
    color === "chip-primary"
      ? "text-status-success bg-emerald-500/10 ring-emerald-500/20"
      : "bg-theme-surface text-theme-secondary ring-theme-contrast/10",
    className,
  ]}
>
  {
    icon && (
      <span class="flex items-center justify-center">
        <slot />
      </span>
    )
  }
  <span>{label}</span>
</div>
