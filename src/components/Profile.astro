---
import Chip from "./Chip.astro";
import EncryptedText from "@components/ui/EncryptedText.astro";

import { MapPin, Mail } from "@lucide/astro";

import profile from "@data/profile.json";
import contact from "@data/contact.json";

const contactLabels: Record<string, string> = {
  EmailIcon: "Enviar un correo electrónico",
  LinkedInIcon: "Ver perfil en LinkedIn",
  GitHubIcon: "Ver perfil en GitHub",
};

const contactIcons: Record<string, string> = {
  GitHubIcon:
    "M12 .297c-6.63 0-12 5.373-12 12c0 5.303 3.438 9.8 8.205 11.385c.6.113.82-.258.82-.577c0-.285-.01-1.04-.015-2.04c-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729c1.205.084 1.838 1.236 1.838 1.236c1.07 1.835 2.809 1.305 3.495.998c.108-.776.417-1.305.76-1.605c-2.665-.3-5.466-1.332-5.466-5.93c0-1.31.465-2.38 1.235-3.22c-.135-.303-.54-1.523.105-3.176c0 0 1.005-.322 3.3 1.23c.96-.267 1.98-.399 3-.405c1.02.006 2.04.138 3 .405c2.28-1.552 3.285-1.23 3.285-1.23c.645 1.653.24 2.873.12 3.176c.765.84 1.23 1.91 1.23 3.22c0 4.61-2.805 5.625-5.475 5.92c.42.36.81 1.096.81 2.22c0 1.606-.015 2.896-.015 3.286c0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  LinkedInIcon:
    "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037c-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85c3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.06 2.06 0 0 1-2.063-2.065a2.064 2.064 0 1 1 2.063 2.065m1.782 13.019H3.555V9h3.564zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z",
};
---

<header class="flex w-full flex-col gap-6">
  <div class="flex items-center gap-4">
    <div
      class="bg-theme-contrast/5 ring-theme-contrast/10 relative flex h-16 w-16 items-center justify-center overflow-hidden rounded-full ring-1"
    >
      <img
        src={profile.imageUrl}
        alt="Foto de perfil"
        width="56"
        height="56"
        loading="eager"
        decoding="async"
        class="h-14 w-14 rounded-full object-cover"
      />
    </div>
    <div class="flex flex-col">
      <EncryptedText as="h1" text={profile.name} className="text-theme-primary text-2xl font-semibold tracking-tight" />
      <EncryptedText as="p" text={profile.title} className="text-theme-muted" />
    </div>
  </div>

  <p class="text-theme-muted max-w-xl text-[15px] leading-relaxed">
    Uno marketing y desarrollo para crear productos digitales que se ven bien, funcionan mejor y dan resultados reales
    al negocio.
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <Chip icon label={profile.location} color="chip-secondary">
      <MapPin width={14} height={14} aria-hidden="true" />
    </Chip>
    <Chip icon label="Disponible para proyectos" color="chip-primary">
      <span aria-hidden="true" class="inline-flex h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400"></span>
    </Chip>
  </div>

  <div class="flex items-center gap-3">
    {
      contact.map((item) => {
        const isExternal = item.url.startsWith("http");

        return (
          <a
            href={item.url}
            class="btn-icon h-9 w-9 rounded-lg"
            aria-label={contactLabels[item.icon] ?? "Contacto"}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            {item.icon === "EmailIcon" ? (
              <Mail width={18} height={18} aria-hidden="true" />
            ) : (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width={18}
                height={18}
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={contactIcons[item.icon]} />
              </svg>
            )}
          </a>
        );
      })
    }
  </div>
</header>
