---
import Chip from "./Chip.astro";
import EncryptedText from "@components/ui/EncryptedText.astro";

import { MapPin, Mail, Github, Linkedin } from "@lucide/astro";

import profile from "@data/profile.json";
import contact from "@data/contact.json";

const contactLabels: Record<string, string> = {
  EmailIcon: "Enviar un correo electrónico",
  LinkedInIcon: "Ver perfil en LinkedIn",
  GitHubIcon: "Ver perfil en GitHub",
};
---

<header class="flex w-full flex-col gap-6">
  <div class="flex items-center gap-4">
    <div
      class="bg-theme-contrast/5 ring-theme-contrast/10 relative flex h-16 w-16 items-center justify-center overflow-hidden rounded-full ring-1"
    >
      <img
        src={profile.imageUrl}
        alt="Foto de perfil"
        width="56"
        height="56"
        loading="eager"
        decoding="async"
        class="h-14 w-14 rounded-full object-cover"
      />
    </div>
    <div class="flex flex-col">
      <EncryptedText as="h1" text={profile.name} className="text-theme-primary text-2xl font-semibold tracking-tight" />
      <EncryptedText as="p" text={profile.title} className="text-theme-muted" />
    </div>
  </div>

  <p class="text-theme-muted max-w-xl text-[15px] leading-relaxed">
    Uno marketing y desarrollo para crear productos digitales que se ven bien, funcionan mejor y dan resultados reales
    al negocio.
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <Chip icon label={profile.location} color="chip-secondary">
      <MapPin width={14} height={14} aria-hidden="true" />
    </Chip>
    <Chip icon label="Disponible para proyectos" color="chip-primary">
      <span aria-hidden="true" class="inline-flex h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400"></span>
    </Chip>
  </div>

  <div class="flex items-center gap-3">
    {
      contact.map((item) => {
        const isExternal = item.url.startsWith("http");

        return (
          <a
            href={item.url}
            class="btn-icon h-9 w-9 rounded-lg"
            aria-label={contactLabels[item.icon] ?? "Contacto"}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            {item.icon === "EmailIcon" && <Mail width={18} height={18} aria-hidden="true" />}
            {item.icon === "GitHubIcon" && <Github width={18} height={18} aria-hidden="true" />}
            {item.icon === "LinkedInIcon" && <Linkedin width={18} height={18} aria-hidden="true" />}
          </a>
        );
      })
    }
  </div>
</header>
