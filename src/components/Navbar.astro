---
import ThemeToggle from "./ThemeToggle.astro";

const { pathname } = Astro.url;

const navItems = [
  { path: "/", label: "Portafolio", match: (p: string) => p === "/" || p.startsWith("/projects") },
  { path: "/blog", label: "Blog", match: (p: string) => p.startsWith("/blog") },
  { path: "/resume", label: "Currículum", match: (p: string) => p.startsWith("/resume") },
];
---

<nav class="fixed top-6 left-1/2 z-50 -translate-x-1/2 px-2">
  <div
    class="bg-theme-surface/90 ring-theme-contrast/10 flex items-center gap-1 rounded-full px-2 py-2 shadow-lg ring-1 shadow-neutral-950/10 backdrop-blur-md dark:shadow-neutral-950/50"
  >
    {
      navItems.map(({ path, label, match }) => {
        const isActive = match(pathname);
        return (
          <a
            href={path}
            class:list={[
              "focus-ring relative rounded-full px-3 py-1.5 text-sm font-medium transition-colors duration-300 sm:px-4",
              isActive
                ? "bg-neutral-50 text-neutral-900 shadow-sm ring-1 ring-neutral-950/5 dark:bg-neutral-800 dark:text-neutral-100 dark:ring-white/10"
                : "text-theme-muted hover:bg-theme-contrast/5 hover:text-theme-primary",
            ]}
          >
            {label}
          </a>
        );
      })
    }
    <span class="bg-theme-contrast/10 mx-0.5 h-5 w-px shrink-0" aria-hidden="true"></span>
    <ThemeToggle />
  </div>
</nav>
